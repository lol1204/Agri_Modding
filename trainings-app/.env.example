# Firebase-Werte deiner Web-App
# (Firebase-Konsole → Zahnrad → Projekteinstellungen → Deine Apps → Web-App → „Konfiguration“).
# Kopiere diese Datei nach `.env` und trage die Werte ein.
# Diese Werte sind nicht geheim (sie landen ohnehin im Browser). Deine Daten
# schützen die Firestore-Regeln: Jeder Nutzer sieht nur seine eigenen Daten.
# Ohne diese Werte zeigt die App nur eine Einrichtungs-Hilfe.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Nur zum Entwickeln ohne echtes Projekt: Projekt-ID mit „demo-“ (z. B. demo-trainings)
# verbindet die App mit den lokalen Firebase-Emulatoren (npm run emulators).
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
