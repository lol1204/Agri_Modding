# Firebase-Werte deiner Web-App (Firebase-Konsole → Projekteinstellungen → Deine Apps → Web).
# Kopiere diese Datei nach `.env` und trage die Werte ein.
# Diese Werte sind nicht geheim (sie landen im Browser), gehören aber zu deinem Projekt.
# Leer lassen = lokaler Modus (Daten nur auf diesem Gerät, kein Login).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
