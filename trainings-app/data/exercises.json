[
  { "id": "bankdruecken-lh", "name": "Bankdrücken (Langhantel)", "primary": ["brust"], "secondary": ["trizeps", "schulter_vorne"], "equipment": "langhantel", "category": "grund", "bodyweight": false, "difficulty": 2, "pattern": "horizontal_druecken", "repRange": [6, 10],
    "tips": ["Schulterblätter zusammen und nach unten ziehen, leichtes Hohlkreuz.", "Stange kontrolliert zur unteren Brust senken, Ellbogen ca. 45° vom Körper.", "Füße fest am Boden, Po bleibt auf der Bank."] },
  { "id": "schraegbank-lh", "name": "Schrägbankdrücken (Langhantel)", "primary": ["brust"], "secondary": ["schulter_vorne", "trizeps"], "equipment": "langhantel", "category": "grund", "bodyweight": false, "difficulty": 2, "pattern": "horizontal_druecken", "repRange": [6, 10],
    "tips": ["Bank auf etwa 30° stellen – steiler belastet vor allem die Schulter.", "Stange zur oberen Brust senken.", "Schulterblätter bleiben während des ganzen Satzes fixiert."] },
  { "id": "bankdruecken-kh", "name": "Bankdrücken (Kurzhanteln)", "primary": ["brust"], "secondary": ["trizeps", "schulter_vorne"], "equipment": "kurzhantel", "category": "grund", "bodyweight": false, "difficulty": 1, "pattern": "horizontal_druecken", "repRange": [8, 12],
    "tips": ["Hanteln seitlich der Brust tief absenken, Dehnung spüren.", "Oben nicht klackern lassen – Spannung halten.", "Hanteln auf den Knien abstützen, um sie in Position zu bringen."] },
  { "id": "schraegbank-kh", "name": "Schrägbankdrücken (Kurzhanteln)", "primary": ["brust"], "secondary": ["schulter_vorne", "trizeps"], "equipment": "kurzhantel", "category": "grund", "bodyweight": false, "difficulty": 1, "pattern": "horizontal_druecken", "repRange": [8, 12],
    "tips": ["Bank auf 30° stellen.", "Ellbogen leicht unter Schulterhöhe führen.", "Langsam ablassen (2–3 Sekunden)."] },
  { "id": "brustpresse", "name": "Brustpresse (Maschine)", "primary": ["brust"], "secondary": ["trizeps", "schulter_vorne"], "equipment": "maschine", "category": "grund", "bodyweight": false, "difficulty": 1, "pattern": "horizontal_druecken", "repRange": [8, 12],
    "tips": ["Sitz so einstellen, dass die Griffe auf Höhe der mittleren Brust sind.", "Schulterblätter an die Lehne drücken.", "Gut für sichere Sätze bis kurz vor dem Versagen."] },
  { "id": "fliegende-kh", "name": "Fliegende (Kurzhanteln)", "primary": ["brust"], "secondary": ["schulter_vorne"], "equipment": "kurzhantel", "category": "isolation", "bodyweight": false, "difficulty": 1, "pattern": "brust_isolation", "repRange": [10, 15],
    "tips": ["Arme leicht gebeugt lassen und in einem Bogen öffnen.", "Nur so tief, wie es in der Schulter angenehm ist.", "Leichte Gewichte reichen – die Dehnung macht den Reiz."] },
  { "id": "butterfly", "name": "Butterfly (Maschine)", "primary": ["brust"], "secondary": [], "equipment": "maschine", "category": "isolation", "bodyweight": false, "difficulty": 1, "pattern": "brust_isolation", "repRange": [10, 15],
    "tips": ["Griffe auf Brusthöhe einstellen.", "Brust aktiv zusammendrücken, kurz halten.", "Ideal für Dropsätze."] },
  { "id": "kabel-crossover", "name": "Kabel-Crossover", "primary": ["brust"], "secondary": ["schulter_vorne"], "equipment": "kabelzug", "category": "isolation", "bodyweight": false, "difficulty": 2, "pattern": "brust_isolation", "repRange": [10, 15],
    "tips": ["Ein Schritt nach vorn, leicht vorgebeugt stehen.", "Hände vor dem Körper zusammenführen, Ellbogen leicht gebeugt.", "Kontrolliert zurück, Spannung nicht verlieren."] },

  { "id": "liegestuetz-erhoeht", "name": "Liegestütz erhöht (Hände auf Bank)", "primary": ["brust"], "secondary": ["trizeps", "schulter_vorne", "bauch"], "equipment": "koerpergewicht", "category": "grund", "bodyweight": true, "difficulty": 1, "pattern": "horizontal_druecken", "repRange": [10, 20], "progression": { "chain": "liegestuetz", "level": 1 },
    "tips": ["Je höher die Hände, desto leichter.", "Körper bildet eine gerade Linie von Kopf bis Fuß.", "Brust bis kurz über die Kante senken."] },
  { "id": "liegestuetz", "name": "Liegestütz", "primary": ["brust"], "secondary": ["trizeps", "schulter_vorne", "bauch"], "equipment": "koerpergewicht", "category": "grund", "bodyweight": true, "difficulty": 1, "pattern": "horizontal_druecken", "repRange": [8, 20], "progression": { "chain": "liegestuetz", "level": 2 },
    "tips": ["Hände etwas breiter als schulterbreit.", "Bauch und Po anspannen – kein Durchhängen.", "Brust fast bis zum Boden."] },
  { "id": "liegestuetz-fuesse-erhoeht", "name": "Liegestütz mit erhöhten Füßen", "primary": ["brust"], "secondary": ["schulter_vorne", "trizeps", "bauch"], "equipment": "koerpergewicht", "category": "grund", "bodyweight": true, "difficulty": 2, "pattern": "horizontal_druecken", "repRange": [8, 15], "progression": { "chain": "liegestuetz", "level": 3 },
    "tips": ["Füße auf Bank oder Stuhl.", "Körper bleibt gestreckt.", "Mehr Last auf oberer Brust und Schulter."] },
  { "id": "archer-liegestuetz", "name": "Archer-Liegestütz", "primary": ["brust"], "secondary": ["trizeps", "schulter_vorne", "bauch"], "equipment": "koerpergewicht", "category": "grund", "bodyweight": true, "difficulty": 3, "pattern": "horizontal_druecken", "repRange": [5, 10], "unilateral": true, "progression": { "chain": "liegestuetz", "level": 4 },
    "tips": ["Sehr breite Handstellung, ein Arm bleibt gestreckt.", "Gewicht auf den beugenden Arm verlagern.", "Seiten abwechseln – Wdh. pro Seite zählen."] },

  { "id": "dips-bank", "name": "Bank-Dips", "primary": ["trizeps"], "secondary": ["brust", "schulter_vorne"], "equipment": "koerpergewicht", "category": "grund", "bodyweight": true, "difficulty": 1, "pattern": "trizeps", "repRange": [10, 20], "progression": { "chain": "dips", "level": 1 },
    "tips": ["Hände hinter dir auf der Bank, Finger nach vorn.", "Nur bis die Oberarme waagerecht sind.", "Mit angewinkelten Beinen leichter, gestreckt schwerer."] },
  { "id": "dips", "name": "Dips (Barren)", "primary": ["brust", "trizeps"], "secondary": ["schulter_vorne"], "equipment": "dipbarren", "category": "grund", "bodyweight": true, "difficulty": 2, "pattern": "horizontal_druecken", "repRange": [6, 12], "progression": { "chain": "dips", "level": 2 },
    "tips": ["Oberkörper leicht nach vorn = mehr Brust, aufrecht = mehr Trizeps.", "Schultern weg von den Ohren halten.", "Mit Zusatzgewicht steigern, wenn 12+ Wdh. leicht gehen."] },
  { "id": "ring-dips", "name": "Ring-Dips", "primary": ["brust", "trizeps"], "secondary": ["schulter_vorne", "bauch"], "equipment": "ringe", "category": "grund", "bodyweight": true, "difficulty": 3, "pattern": "horizontal_druecken", "repRange": [5, 10], "progression": { "chain": "dips", "level": 3 },
    "tips": ["Ringe nah am Körper halten, oben nach außen drehen.", "Langsam ablassen – die Instabilität ist der Reiz.", "Erst mit sauberen Barren-Dips (10+) beginnen."] },

  { "id": "klimmzug-band", "name": "Klimmzüge mit Band", "primary": ["lat"], "secondary": ["bizeps", "oberer_ruecken"], "equipment": "klimmzugstange", "category": "grund", "bodyweight": true, "difficulty": 1, "pattern": "vertikal_ziehen", "repRange": [6, 12], "progression": { "chain": "klimmzug", "level": 1 },
    "tips": ["Band über die Stange, Fuß oder Knie hinein.", "Dünneres Band = schwerer.", "Brust zur Stange ziehen, Schulterblätter nach unten."] },
  { "id": "klimmzug-negativ", "name": "Negative Klimmzüge", "primary": ["lat"], "secondary": ["bizeps", "oberer_ruecken"], "equipment": "klimmzugstange", "category": "grund", "bodyweight": true, "difficulty": 2, "pattern": "vertikal_ziehen", "repRange": [3, 6], "progression": { "chain": "klimmzug", "level": 2 },
    "tips": ["Mit Sprung oder Kasten nach oben, dann 3–5 Sekunden ablassen.", "Ganz unten Arme kurz strecken.", "Baut die Kraft für den ersten echten Klimmzug auf."] },
  { "id": "klimmzug", "name": "Klimmzüge", "primary": ["lat"], "secondary": ["bizeps", "oberer_ruecken", "unterarme"], "equipment": "klimmzugstange", "category": "grund", "bodyweight": true, "difficulty": 3, "pattern": "vertikal_ziehen", "repRange": [5, 10], "progression": { "chain": "klimmzug", "level": 3 },
    "tips": ["Obergriff, etwas breiter als schulterbreit.", "Aus dem Hang ohne Schwung ziehen, bis das Kinn über der Stange ist.", "Ab 10 sauberen Wdh. mit Zusatzgewicht steigern."] },
  { "id": "klimmzug-archer", "name": "Archer-Klimmzüge", "primary": ["lat"], "secondary": ["bizeps", "oberer_ruecken"], "equipment": "klimmzugstange", "category": "grund", "bodyweight": true, "difficulty": 3, "pattern": "vertikal_ziehen", "repRange": [3, 8], "unilateral": true, "progression": { "chain": "klimmzug", "level": 4 },
    "tips": ["Sehr breiter Griff, zu einer Hand ziehen.", "Der andere Arm bleibt fast gestreckt.", "Seiten abwechseln."] },
  { "id": "chin-up", "name": "Chin-ups (Untergriff)", "primary": ["lat", "bizeps"], "secondary": ["oberer_ruecken"], "equipment": "klimmzugstange", "category": "grund", "bodyweight": true, "difficulty": 2, "pattern": "vertikal_ziehen", "repRange": [5, 10],
    "tips": ["Untergriff, schulterbreit.", "Etwas leichter als Klimmzüge, mehr Bizeps.", "Volle Bewegung: unten Arme strecken."] },
  { "id": "latziehen", "name": "Latziehen", "primary": ["lat"], "secondary": ["bizeps", "oberer_ruecken"], "equipment": "kabelzug", "category": "grund", "bodyweight": false, "difficulty": 1, "pattern": "vertikal_ziehen", "repRange": [8, 12],
    "tips": ["Oberschenkel fest unter das Polster.", "Stange zur oberen Brust ziehen, leicht zurücklehnen.", "Ellbogen nach unten und hinten führen."] },
  { "id": "latziehen-eng", "name": "Latziehen eng (neutraler Griff)", "primary": ["lat"], "secondary": ["bizeps", "oberer_ruecken"], "equipment": "kabelzug", "category": "grund", "bodyweight": false, "difficulty": 1, "pattern": "vertikal_ziehen", "repRange": [8, 12],
    "tips": ["V-Griff oder enger Parallelgriff.", "Ellbogen eng am Körper nach unten ziehen.", "Oben die Dehnung im Lat zulassen."] },
  { "id": "rudern-lh", "name": "Langhantelrudern", "primary": ["oberer_ruecken", "lat"], "secondary": ["bizeps", "schulter_hinten", "unterer_ruecken"], "equipment": "langhantel", "category": "grund", "bodyweight": false, "difficulty": 2, "pattern": "horizontal_ziehen", "repRange": [6, 10],
    "tips": ["Oberkörper etwa 45° vorgebeugt, Rücken gerade.", "Stange zum Bauchnabel ziehen.", "Kein Schwung aus der Hüfte."] },
  { "id": "rudern-kh", "name": "Kurzhantelrudern einarmig", "primary": ["lat", "oberer_ruecken"], "secondary": ["bizeps", "schulter_hinten"], "equipment": "kurzhantel", "category": "grund", "bodyweight": false, "difficulty": 1, "pattern": "horizontal_ziehen", "repRange": [8, 12], "unilateral": true,
    "tips": ["Knie und Hand auf der Bank abstützen.", "Hantel Richtung Hüfte ziehen, Ellbogen nah am Körper.", "Unten ganz strecken."] },
  { "id": "kabelrudern", "name": "Kabelrudern sitzend", "primary": ["oberer_ruecken", "lat"], "secondary": ["bizeps", "schulter_hinten"], "equipment": "kabelzug", "category": "grund", "bodyweight": false, "difficulty": 1, "pattern": "horizontal_ziehen", "repRange": [8, 12],
    "tips": ["Aufrecht sitzen, nicht nach hinten kippen.", "Griff zum Bauch ziehen, Schulterblätter zusammen.", "Kontrolliert nach vorn lassen."] },
  { "id": "rudern-maschine", "name": "Rudern an der Maschine (brustgestützt)", "primary": ["oberer_ruecken", "lat"], "secondary": ["bizeps", "schulter_hinten"], "equipment": "maschine", "category": "grund", "bodyweight": false, "difficulty": 1, "pattern": "horizontal_ziehen", "repRange": [8, 12],
    "tips": ["Brust bleibt am Polster.", "Schulterblätter zuerst zusammenziehen, dann die Arme.", "Gut geeignet für Dropsätze."] },
  { "id": "rudern-koerper", "name": "Rudern am Körper (Ringe/Stange)", "primary": ["oberer_ruecken", "lat"], "secondary": ["bizeps", "schulter_hinten", "bauch"], "equipment": "ringe", "category": "grund", "bodyweight": true, "difficulty": 1, "pattern": "horizontal_ziehen", "repRange": [8, 15], "progression": { "chain": "rudern-kg", "level": 1 },
    "tips": ["Je flacher der Körper, desto schwerer.", "Körper gestreckt wie beim Liegestütz.", "Brust zu den Händen ziehen."] },
  { "id": "rudern-koerper-fuesse-erhoeht", "name": "Rudern am Körper, Füße erhöht", "primary": ["oberer_ruecken", "lat"], "secondary": ["bizeps", "schulter_hinten", "bauch"], "equipment": "ringe", "category": "grund", "bodyweight": true, "difficulty": 2, "pattern": "horizontal_ziehen", "repRange": [6, 12], "progression": { "chain": "rudern-kg", "level": 2 },
    "tips": ["Füße auf Bank oder Stuhl.", "Körper waagerecht halten.", "Oben kurz halten."] },
  { "id": "kreuzheben", "name": "Kreuzheben (Langhantel)", "primary": ["gesaess", "unterer_ruecken", "beinbeuger"], "secondary": ["oberer_ruecken", "quadrizeps", "unterarme"], "equipment": "langhantel", "category": "grund", "bodyweight": false, "difficulty": 3, "pattern": "hueftstreckung", "repRange": [4, 8],
    "tips": ["Stange über der Fußmitte, nah an den Schienbeinen.", "Rücken neutral, Brust raus, Lat anspannen.", "Mit den Beinen vom Boden drücken, Hüfte und Schultern steigen gleich schnell."] },
  { "id": "rumaenisches-kreuzheben", "name": "Rumänisches Kreuzheben (Langhantel)", "primary": ["beinbeuger", "gesaess"], "secondary": ["unterer_ruecken"], "equipment": "langhantel", "category": "grund", "bodyweight": false, "difficulty": 2, "pattern": "hueftstreckung", "repRange": [6, 10],
    "tips": ["Knie leicht gebeugt, Hüfte nach hinten schieben.", "Stange an den Beinen entlang bis unter die Knie.", "Dehnung hinten im Oberschenkel spüren, Rücken gerade."] },
  { "id": "rumaenisches-kreuzheben-kh", "name": "Rumänisches Kreuzheben (Kurzhanteln)", "primary": ["beinbeuger", "gesaess"], "secondary": ["unterer_ruecken"], "equipment": "kurzhantel", "category": "grund", "bodyweight": false, "difficulty": 1, "pattern": "hueftstreckung", "repRange": [8, 12],
    "tips": ["Hanteln vor den Oberschenkeln führen.", "Hüfte nach hinten, Rücken gerade.", "Oben Po anspannen."] },
  { "id": "hip-thrust", "name": "Hip Thrust (Langhantel)", "primary": ["gesaess"], "secondary": ["beinbeuger"], "equipment": "langhantel", "category": "grund", "bodyweight": false, "difficulty": 2, "pattern": "hueftstreckung", "repRange": [8, 12],
    "tips": ["Oberer Rücken auf der Bank, Polster um die Stange.", "Hüfte strecken, bis Oberkörper und Oberschenkel eine Linie bilden.", "Oben 1 Sekunde Po anspannen."] },
  { "id": "hyperextensions", "name": "Rückenstrecker (Hyperextensions)", "primary": ["unterer_ruecken", "gesaess"], "secondary": ["beinbeuger"], "equipment": "maschine", "category": "isolation", "bodyweight": true, "difficulty": 1, "pattern": "hueftstreckung", "repRange": [10, 15],
    "tips": ["Polster knapp unter dem Hüftknochen.", "Langsam absenken, nur bis zur geraden Linie hochkommen.", "Mit Hantelscheibe vor der Brust steigern."] },

  { "id": "schulterdruecken-lh", "name": "Schulterdrücken stehend (Langhantel)", "primary": ["schulter_vorne"], "secondary": ["schulter_seite", "trizeps", "bauch"], "equipment": "langhantel", "category": "grund", "bodyweight": false, "difficulty": 2, "pattern": "vertikal_druecken", "repRange": [5, 8],
    "tips": ["Stange startet auf der oberen Brust.", "Po und Bauch fest – kein Hohlkreuz.", "Kopf kurz zurück, Stange gerade nach oben."] },
  { "id": "schulterdruecken-kh", "name": "Schulterdrücken sitzend (Kurzhanteln)", "primary": ["schulter_vorne"], "secondary": ["schulter_seite", "trizeps"], "equipment": "kurzhantel", "category": "grund", "bodyweight": false, "difficulty": 1, "pattern": "vertikal_druecken", "repRange": [8, 12],
    "tips": ["Lehne fast senkrecht.", "Hanteln bis etwa Ohrhöhe senken.", "Oben nicht ganz zusammenführen."] },
  { "id": "schulterpresse", "name": "Schulterpresse (Maschine)", "primary": ["schulter_vorne"], "secondary": ["schulter_seite", "trizeps"], "equipment": "maschine", "category": "grund", "bodyweight": false, "difficulty": 1, "pattern": "vertikal_druecken", "repRange": [8, 12],
    "tips": ["Griffe auf Schulterhöhe einstellen.", "Rücken an der Lehne lassen.", "Gleichmäßiges Tempo."] },
  { "id": "pike-liegestuetz", "name": "Pike-Liegestütz", "primary": ["schulter_vorne"], "secondary": ["trizeps", "schulter_seite"], "equipment": "koerpergewicht", "category": "grund", "bodyweight": true, "difficulty": 2, "pattern": "vertikal_druecken", "repRange": [6, 12], "progression": { "chain": "handstand", "level": 1 },
    "tips": ["Hüfte hoch, Körper bildet ein umgedrehtes V.", "Kopf zwischen die Hände senken.", "Füße erhöht = schwerer."] },
  { "id": "handstand-liegestuetz", "name": "Handstand-Liegestütz an der Wand", "primary": ["schulter_vorne"], "secondary": ["trizeps", "schulter_seite", "oberer_ruecken"], "equipment": "koerpergewicht", "category": "grund", "bodyweight": true, "difficulty": 3, "pattern": "vertikal_druecken", "repRange": [3, 8], "progression": { "chain": "handstand", "level": 2 },
    "tips": ["Mit dem Bauch oder Rücken zur Wand.", "Kopf kontrolliert bis kurz über den Boden.", "Polster unter den Kopf legen."] },
  { "id": "seitheben-kh", "name": "Seitheben (Kurzhanteln)", "primary": ["schulter_seite"], "secondary": [], "equipment": "kurzhantel", "category": "isolation", "bodyweight": false, "difficulty": 1, "pattern": "seitheben", "repRange": [12, 20],
    "tips": ["Arme leicht gebeugt seitlich bis Schulterhöhe heben.", "Führe mit den Ellbogen, nicht mit den Händen.", "Kein Schwung – lieber leichter."] },
  { "id": "seitheben-kabel", "name": "Seitheben am Kabel", "primary": ["schulter_seite"], "secondary": [], "equipment": "kabelzug", "category": "isolation", "bodyweight": false, "difficulty": 1, "pattern": "seitheben", "repRange": [12, 20], "unilateral": true,
    "tips": ["Kabel unten, vor dem Körper vorbei greifen.", "Gleichmäßige Spannung über die ganze Bewegung.", "Seiten nacheinander."] },
  { "id": "seitheben-maschine", "name": "Seitheben (Maschine)", "primary": ["schulter_seite"], "secondary": [], "equipment": "maschine", "category": "isolation", "bodyweight": false, "difficulty": 1, "pattern": "seitheben", "repRange": [12, 20],
    "tips": ["Schultern auf Höhe der Drehachse.", "Oben kurz halten.", "Gut geeignet für Dropsätze."] },
  { "id": "face-pulls", "name": "Face Pulls", "primary": ["schulter_hinten"], "secondary": ["oberer_ruecken"], "equipment": "kabelzug", "category": "isolation", "bodyweight": false, "difficulty": 1, "pattern": "hintere_schulter", "repRange": [12, 20],
    "tips": ["Seil auf Kopfhöhe.", "Zum Gesicht ziehen, Hände auseinander, Daumen nach hinten.", "Gut für gesunde Schultern."] },
  { "id": "reverse-flys-kh", "name": "Reverse Flys (Kurzhanteln)", "primary": ["schulter_hinten"], "secondary": ["oberer_ruecken"], "equipment": "kurzhantel", "category": "isolation", "bodyweight": false, "difficulty": 1, "pattern": "hintere_schulter", "repRange": [12, 20],
    "tips": ["Vorgebeugt oder bäuchlings auf der Schrägbank.", "Arme seitlich öffnen, leicht gebeugt.", "Leichte Gewichte, sauber ausführen."] },
  { "id": "reverse-butterfly", "name": "Reverse Butterfly (Maschine)", "primary": ["schulter_hinten"], "secondary": ["oberer_ruecken"], "equipment": "maschine", "category": "isolation", "bodyweight": false, "difficulty": 1, "pattern": "hintere_schulter", "repRange": [12, 20],
    "tips": ["Brust ans Polster.", "Arme nach hinten öffnen, nicht die Schultern hochziehen.", "Ideal für Dropsätze."] },

  { "id": "bizepscurl-lh", "name": "Bizepscurls (Langhantel)", "primary": ["bizeps"], "secondary": ["unterarme"], "equipment": "langhantel", "category": "isolation", "bodyweight": false, "difficulty": 1, "pattern": "bizeps", "repRange": [8, 12],
    "tips": ["Ellbogen bleiben am Körper.", "Kein Schwung aus dem Rücken.", "Langsam ablassen."] },
  { "id": "sz-curls", "name": "SZ-Curls", "primary": ["bizeps"], "secondary": ["unterarme"], "equipment": "sz_stange", "category": "isolation", "bodyweight": false, "difficulty": 1, "pattern": "bizeps", "repRange": [8, 12],
    "tips": ["Schonender für die Handgelenke als die gerade Stange.", "Oben kurz anspannen.", "Volle Streckung unten."] },
  { "id": "bizepscurl-kh", "name": "Bizepscurls (Kurzhanteln)", "primary": ["bizeps"], "secondary": ["unterarme"], "equipment": "kurzhantel", "category": "isolation", "bodyweight": false, "difficulty": 1, "pattern": "bizeps", "repRange": [8, 12],
    "tips": ["Handgelenk beim Hochheben nach außen drehen.", "Abwechselnd oder gleichzeitig.", "Oberarme ruhig halten."] },
  { "id": "hammercurls", "name": "Hammercurls", "primary": ["bizeps", "unterarme"], "secondary": [], "equipment": "kurzhantel", "category": "isolation", "bodyweight": false, "difficulty": 1, "pattern": "bizeps", "repRange": [8, 12],
    "tips": ["Daumen zeigen nach oben (Neutralgriff).", "Ellbogen am Körper.", "Trainiert auch die Unterarme."] },
  { "id": "kabelcurls", "name": "Bizepscurls am Kabel", "primary": ["bizeps"], "secondary": [], "equipment": "kabelzug", "category": "isolation", "bodyweight": false, "difficulty": 1, "pattern": "bizeps", "repRange": [10, 15],
    "tips": ["Konstante Spannung über die ganze Bewegung.", "Einen Schritt vom Turm weg stehen.", "Gut für Dropsätze."] },
  { "id": "scottcurls", "name": "Scottcurls (Maschine)", "primary": ["bizeps"], "secondary": [], "equipment": "maschine", "category": "isolation", "bodyweight": false, "difficulty": 1, "pattern": "bizeps", "repRange": [8, 12],
